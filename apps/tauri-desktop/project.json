{
    "name": "tauri-desktop",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/tauri-desktop/src-tauri/src",
    "implicitDependencies": [
        "web"
    ],
    "tags": [
        "scope:tauri",
        "domain:tauri-main",
        "type:app"
    ],
    "targets": {
        "cargo-test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo test",
                "cwd": "apps/tauri-desktop/src-tauri"
            }
        },
        "cargo-clippy": {
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo clippy --all-targets -- -D warnings",
                "cwd": "apps/tauri-desktop/src-tauri"
            }
        },
        "tauri-dev": {
            "executor": "nx:run-commands",
            "options": {
                "command": "cargo tauri dev",
                "cwd": "apps/tauri-desktop/src-tauri"
            }
        },
        "tauri-build": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": [
                        "web"
                    ],
                    "target": "build"
                }
            ],
            "options": {
                "command": "cargo tauri build",
                "cwd": "apps/tauri-desktop/src-tauri"
            }
        }
    }
}
