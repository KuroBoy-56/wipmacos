{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Main window: only the migrated bridge commands, event listening and window dragging. No fs, shell or http plugin.",
    "windows": ["main"],
    "local": true,
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-unlisten",
        "core:window:allow-start-dragging",
        "allow-app-version",
        "allow-window-minimize",
        "allow-window-toggle-maximize",
        "allow-window-close",
        "allow-window-get-state",
        "allow-panel-get-device-id",
        "allow-panel-login-request",
        "allow-panel-report-error"
    ]
}
