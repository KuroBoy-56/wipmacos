{
    "appId": "com.fourgray.iptvnator",
    "productName": "MPX Player",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
        "buildResources": "dist/apps",
        "output": "dist/executables"
    },
    "files": [
        {
            "from": "dist/apps/remote-control-web",
            "to": "remote-control-web",
            "filter": ["**/*"]
        },
        "electron-backend/**/*",
        "web/**/*",
        "!**/*.map"
    ],
    "asarUnpack": [
        "**/better-sqlite3/**",
        "**/bindings/**",
        "**/file-uri-to-path/**",
        "**/*.node",
        "**/*.dylib",
        "**/*.dll",
        "**/*.so",
        "**/*.so.*",
        "**/embedded-mpv-runtime.json"
    ],
    "extraMetadata": {
        "name": "LatMpx TV+",
        "productName": "MPX Player",
        "main": "electron-backend/main.js"
    },
    "extraResources": [
        "dist/apps/electron-backend/workers",
        {
            "from": "bin",
            "to": "bin",
            "filter": ["**/*"]
        }
    ],
    "mac": {
        "target": [
            {
                "target": "dmg",
                "arch": ["x64", "arm64"]
            },
            {
                "target": "zip",
                "arch": ["x64", "arm64"]
            }
        ],
        "category": "public.app-category.video",
        "forceCodeSigning": true,
        "gatekeeperAssess": false,
        "hardenedRuntime": true,
        "entitlements": "apps/electron-backend/macos/entitlements.mac.plist",
        "entitlementsInherit": "apps/electron-backend/macos/entitlements.mac.inherit.plist",
        "notarize": true,
        "icon": "apps/web/src/assets/icons/favicon.icns"
    },
    "linux": {
        "category": "Video",
        "executableName": "mpx-player",
        "synopsis": "IPTV player for the MPX panel",
        "executableArgs": ["--ozone-platform=x11"],
        "desktop": {
            "entry": {
                "Name": "MPX Player",
                "StartupWMClass": "MPX Player",
                "Categories": "AudioVideo;Video;Player;TV;"
            }
        },
        "target": [
            {
                "target": "AppImage",
                "arch": ["x64"]
            },
            {
                "target": "deb",
                "arch": ["x64"]
            },
            {
                "target": "rpm",
                "arch": ["x64"]
            }
        ],
        "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
        "icon": "apps/web/src/assets/icons"
    },
    "afterPack": "./tools/packaging/electron-after-pack.cjs",
    "win": {
        "compression": "maximum",
        "target": [
            {
                "target": "nsis",
                "arch": ["x64"]
            },
            {
                "target": "nsis",
                "arch": ["ia32"]
            },
            {
                "target": "nsis",
                "arch": ["x64", "ia32"]
            }
        ],
        "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}",
        "icon": "apps/web/src/assets/icons/icon.png"
    },
    "nsis": {
        "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}",
        "deleteAppDataOnUninstall": true
    }
}
